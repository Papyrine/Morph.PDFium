<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <!-- ProjectDefaults decides packability before this file is read, so switch it off here. -->
    <IsPackable>false</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <GenerateSBOM>false</GenerateSBOM>
    <!-- Copies only the build machine's pdfium native, not all 12 RIDs. -->
    <UseCurrentRuntimeIdentifier>true</UseCurrentRuntimeIdentifier>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="ProjectDefaults" PrivateAssets="all" />
    <ProjectReference Include="..\Morph.PDFium\Morph.PDFium.csproj" />
  </ItemGroup>
</Project>
